# Copy this file to config/db.properties and fill in your own values.
# config/db.properties is git-ignored. NEVER commit a real password.
# DB가 없어도 테스트(./mvnw test)는 DB 연결 테스트만 건너뛰고 통과한다.

# 실제 사용 DB의 JDBC 주소 (형식: jdbc:mysql://호스트:포트/DB이름)
db.url=
# 테스트 전용 DB의 JDBC 주소. 테스트는 이 DB의 테이블을 지우고 다시 만든다
db.test.url=
# root가 아닌 앱 전용 계정
db.user=
db.password=

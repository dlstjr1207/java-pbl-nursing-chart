# AI 중계 서버 설정 (맥미니). config/relay.properties로 복사해 고친다. 없으면 아래 기본값을 쓴다.
# 키는 여기 넣지 않는다 (키·모델·주소는 config/ai.properties).
# 포트 (터널이 이 포트로 연결한다)
relay.port=8787
# 하루 전체 요청 수 상한. 넘으면 "오늘 사용량을 모두 썼습니다". 케이스 생성 1회는 요청 1~3회, 해설 1회는 요청 1~2회.
relay.dailyLimit=300
# 요청 본문 최대 크기 (바이트)
relay.maxBodyBytes=262144
# 여는 주소. 127.0.0.1이면 같은 맥(터널)에서만 접속된다. 바꾸지 않는다.
relay.bindHost=127.0.0.1
